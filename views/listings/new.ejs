
<% layout("layouts/boilerplate")%>


<body>

<div class="row">

    <div class="col-7 offset-2" >
        
<br><br>

    
    <h2>Create new listing</h2>
    <form method="POST" action="/listings">


        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input name="listing[title]" placeholder="enter title" type="text" class="form-control" />

        </div>
        
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" class=form-control rows="6">enter description</textarea>

        </div>

        <div class="mb-3">
            <label for="image" class="form-label">Image Link</label>
            <input name="listing[image]" placeholder="enter image url" type="text" class="form-control" />

        </div>




        

        <div class="mb-3">
            <label for="price" class="form-label">Price</label>
            <input name="listing[price]" placeholder="enter price" type="number" class="form-control" />
    

        </div>
        
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input name="listing[location]" placeholder="enter location" type="text" class="form-control" />
        

        </div>

        <div class="mb-3">
            <label for="country" class="form-label">Country</label>
            <input name="listing[country]" placeholder="enter country name" type="text" class="form-control" />


        </div>


        

<br><br>
      

        <button class="btn btn-dark add-btn">Add</button> <br><br>

    </form>
 
    

    </div>

</div>


</body>
