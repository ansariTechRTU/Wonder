<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wonder</title>
</head>
<body>
    <h2>Create new listing</h2>
    <form method="POST" action="/listings">
        <input name="listing[title]" placeholder="enter title" type="text" />
        <br /><br />
        <textarea name="listing[description]" >enter description</textarea>
        <br /><br />
        <input name="listing[image]" placeholder="enter image url" type="text" />
        <br /><br />
        <input name="listing[price]" placeholder="enter price" type="number" />
        <br /><br />
        <input name="listing[location]" placeholder="enter location" type="text" />
        <br /><br />
        <input name="listing[country]" placeholder="enter country name" type="text" />
<br /><br /><br />
        <button>Add</button>

    </form>
    
</body>
</html>