
<% layout("layouts/boilerplate")%>

<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";

    const listing = <%- JSON.stringify(listing) %>;   // goes in map.js file

</script>


<body>

    <div class="row mt-3">
        <div class="col-7 offset-2">
    

    

    <div class="card col-10 offset-2 listing-card">
        <h3><%= listing.title %></h3><br>
        <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="listing image" >
        
        <div class="card-body">
            <p class="card-text">

                <p class="card-text">Owned By: <i><%= listing.owner.username %></i> <br> </p>

                <p class="card-text"> <%= listing.description %><br>  </p>
                <p class="card-text"> <%= listing.price.toLocaleString("lv-LV", { style: "currency", currency: "EUR" }) %><br> </p>
                <p class="card-text"> <%= listing.location %><br> </p>
                <p class="card-text"> <%= listing.country %><br> </p>

            
            
            </p>
        </div>
    </div>



    <!-- <ul>
        <li><%= //listing.title %></li>
        <li><%= //listing.description %></li>
        <li><%= //listing.price.toLocaleString("lv-LV", { style: "currency", currency: "EUR" }) %></li>
        <li><%= //listing.location %></li>
        <li><%= //listing.country %></li>
    </ul> -->



    <% if(currUser && currUser._id.equals(listing.owner._id)) {%>
    
    <div class="edit-delete">
    
    <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark offset-2">Edit</a>
    <br>

    <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
        <button class="btn btn-dark delete-btn mt-4 offset-2">Delete</button> <br><br>


    </form>

    </div>

    <%}%>

   





  


    <div class="col-10 offset-2">
        

        <% if(currUser) { %>
        <hr>
        <h4>Leave a review</h4>

        <form class="mb-3 needs-validation" method="POST" action="/listings/<%=listing._id%>/reviews" novalidate>



<div class="mb-3 mt-3">
  <label for="rating" class="form-label">Rating</label>
  <fieldset class="starability-slot">
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
  </fieldset>


  </div>

        




            <div class="mb-3 mt-3">
                <label for="comment" class="form-label">Comments</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control" required></textarea>

                <div class="invalid-feedback">enter some comment for your review!</div>

            </div>

            <button class="btn btn-outline-dark">Submit</button>


        </form>


     <% } %>



<br>


        
      <% if(listing.reviews.length > 0) { %>

        <hr>

        <div class="row">
            <h4>All reviews : </h4>
       <% for(review of listing.reviews){ %>

            <div class="card col-5 mb-3 mt-3 ms-3">
                <div class="card-body">
                    <h5 class="card-title">@<%= review.author.username %></h5>
                    <p class="starability-result card-text" data-rating= <%=review.rating%> ></p>
                    <p class="card-text"><%=review.comment%></p>
                
                    

                </div>

                
                <form class="mb-2 " method="POST" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                    <button class="btn btn-sm btn-dark">Delete review</button>
                </form>
                

            </div>

       <% } %>


       </div>

       <% } %>




    </div>


    
<!-- i jus used the styling of card for map too -->

    <div class="card col-10 offset-2 listing-card">
        <hr>
        <h4>Where you'll be : </h4>

        <div class="card-img-top show-img" id="map"></div>

        
    </div>

    <script src="/js/map.js"></script>






    



</div>
</div>


</body>
